class employee():
    a=1
    @classmethod
    def show(cls):
        print(f"the class attribute of the a is {cls.a}")
    @property
    def name(self):
        return f"{self.fname}  {self.lname}"
    @name.setter
    def name (self,value):
        self.fname=value.split(" ")[0]
        self.lname=value.split(" ")[1]

ao=employee()
ao.a=34
ao.name="yash aarya"
print(ao.fname , ao.lname)
ao.show()
